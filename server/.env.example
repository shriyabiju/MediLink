# Copy this file to .env and fill in your values
# Never commit .env to version control

# MongoDB connection string
# Local: mongodb://localhost:27017/medilink
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/medilink
MONGO_URI=mongodb://localhost:27017/medilink

# JWT secret — use a long, random string in production
JWT_SECRET=medilink_jwt_secret_change_in_production_2026

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
