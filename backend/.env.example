# ─────────────────────────────────────────
# MediLink Backend - Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and change values if needed.
# The .env file is NOT committed to GitHub (it's in .gitignore).

# MongoDB connection string
# This connects to your local MongoDB (the one you see in Compass)
MONGO_URI=mongodb://localhost:27017/medilink

# Secret key used to sign JWT tokens (change this to any random string)
JWT_SECRET=my_simple_secret_key_123

# How long the login token stays valid
JWT_EXPIRES_IN=7d

# Port the server runs on (must match vite.config.js proxy target)
PORT=5000
